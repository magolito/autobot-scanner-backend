# ─── STRIPE ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Get these from Stripe Dashboard → Products → Pricing
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxxxxxxxxxx

# Your Stripe billing portal URL
BILLING_PORTAL_URL=https://billing.stripe.com/p/login/xxxx

# ─── DISCORD BOT ──────────────────────────────────────────────
# Create at discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret

# Your Discord server ID (right-click server → Copy Server ID)
DISCORD_GUILD_ID=your_server_id_here

# Role IDs (Server Settings → Roles → right-click role → Copy Role ID)
DISCORD_ROLE_MONTHLY=monthly_role_id_here
DISCORD_ROLE_YEARLY=yearly_role_id_here
DISCORD_ROLE_FREE=free_role_id_here

# Discord OAuth redirect (must match what's set in Discord app settings)
DISCORD_REDIRECT_URI=https://yoursite.com/auth/discord/callback

# ─── YOUR SITE ────────────────────────────────────────────────
SITE_URL=https://yoursite.com
PORT=3001
