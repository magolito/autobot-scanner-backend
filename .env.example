# Optional — social pillar degrades gracefully to excluded/redistributed if unset
LUNARCRUSH_API_KEY=your_key_here

# Optional — whale context endpoint returns empty without this
WHALE_ALERT_API_KEY=your_key_here

# Optional — closes the top-trader-ratio gap; falls back to free Bybit+Binance without it
COINGLASS_API_KEY=your_key_here

# Optional — only needed if alerts.telegram.enabled / alerts.discord.enabled in settings.yaml
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
DISCORD_WEBHOOK_URL=your_webhook_url_here

# Dashboard login — required if auth.enabled: true in settings.yaml (the default).
# Pick a real password before deploying anywhere reachable; the dashboard's
# "Scan Now" triggers real, sometimes paid, API calls.
DASHBOARD_PASSWORD=change_me_before_deploying

# Billing (Stage 3) — only needed if stripe.enabled / crypto_payments.enabled in settings.yaml
STRIPE_SECRET_KEY=sk_test_or_live_from_stripe_dashboard
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_webhook_endpoint_settings
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# SQLite file path for scan history / backtesting
SCANNER_DB_PATH=opportunity_scanner.db

# Optional — set to share cache state across multiple process instances (e.g. API + scheduler worker)
REDIS_URL=redis://localhost:6379

# Uvicorn port (used if you run via `python -m opportunity_scanner.api` style scripts)
PORT=8000
